# Machine-local secrets & configuration — never commit
# (holds net24.baseUrl, the online lossless source's site URL)
local.properties

# Release signing keystore + its password file — NEVER commit.
# Losing the keystore means already-installed devices can no longer update in place.
*.p12
*.jks
*.keystore
keystore.properties

# Release output (built APK + self-check artifacts)
dist/

# Gradle
.gradle/
build/

# Android Studio / IntelliJ
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/

# Kotlin
.kotlin/

# Native build output
app/src/main/obj/
app/src/main/libs/

# Local session / build artifacts
.build.log
.workbuddy/
.commandcode/

# Stale backup of gradlew.bat from an earlier debugging session
gradlew.bat.bak

# OS
.DS_Store
Thumbs.db

# Rust build output (musicspace)
native/musicspace/target/
